<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>moe.uwucocoa.hako.worker</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/libexec/hako/hako</string><string>agent</string>
    <string>--config</string><string>/Library/Application Support/Hako/worker.json</string>
    <string>--interval</string><string>2s</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Library/Logs/Hako/worker.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/Hako/worker.log</string>
</dict></plist>
